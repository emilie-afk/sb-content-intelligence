{
  "name": "sb-social-dashboard",
  "version": "1.0.0",
  "description": "Succulents Box social listening dashboard",
  "scripts": {
    "dev": "netlify dev",
    "test": "node --test tests/unit/*.test.js tests/apps-script/*.test.js tests/static/*.test.js",
    "test:db": "tests/db/run.sh",
    "test:browser": "node tests/browser/check.js",
    "check": "for f in netlify/functions/*.js netlify/lib/*.js scripts/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5"
  },
  "engines": {
    "node": ">=18"
  }
}
